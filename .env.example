ORS_API_KEY=

# Environmental data provider.
# Options:
#   demo       — Fixed demonstration values; no external API required.
#   open_meteo — Live weather from Open-Meteo (free, no API key required).
#                Open-Meteo is an open-source weather API. See: https://open-meteo.com/en/terms
#                For non-commercial and research use only.
#                Conditions are NWP model-derived, not station measurements.
ENVIRONMENTAL_PROVIDER=demo

# CORS: comma-separated list of allowed frontend origins.
# Local dev default is set in code. Override for production.
# Example: CORS_ORIGINS=https://main.d1abc123.amplifyapp.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port the backend listens on. AWS App Runner injects PORT automatically.
# Only set this manually for local docker testing.
# PORT=8000
